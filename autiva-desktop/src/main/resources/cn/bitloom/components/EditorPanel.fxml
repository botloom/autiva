<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="editorPanel"
      styleClass="editor-panel"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.bitloom.controller.EditorPanelController"
      stylesheets="@../style/editor-panel.css, @../style/home-page.css"
      visible="false" managed="false"
      minWidth="480" prefWidth="640"
>
    <StackPane fx:id="viewContainer" styleClass="editor-panel__views" VBox.vgrow="ALWAYS">
        <VBox fx:id="toolCallsView" styleClass="editor-panel__view"
              visible="false" managed="false" VBox.vgrow="ALWAYS">
            <ScrollPane styleClass="editor-panel__card-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="toolCallsContainer" styleClass="editor-panel__card-container"/>
            </ScrollPane>
        </VBox>
        <VBox fx:id="todoView" styleClass="editor-panel__view"
              visible="false" managed="false" VBox.vgrow="ALWAYS">
            <ScrollPane styleClass="editor-panel__card-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="todoContainer" styleClass="editor-panel__card-container"/>
            </ScrollPane>
        </VBox>
    </StackPane>
</VBox>
