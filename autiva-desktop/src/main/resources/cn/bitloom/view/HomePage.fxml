<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import cn.bitloom.node.svg.SvgImageView?>

<VBox fx:id="homePage" styleClass="home-page" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="cn.bitloom.controller.HomePageController"
      alignment="CENTER"
      VBox.vgrow="ALWAYS"
      spacing="20"
      stylesheets="@../style/home-page.css"
>

    <VBox fx:id="icon" styleClass="home-page__icon" alignment="CENTER">
        <SvgImageView fitWidth="120" fitHeight="120" svgPath="/cn/bitloom/images/icon.svg"/>
    </VBox>

    <ScrollPane fx:id="chatScrollPane"
                visible="false" managed="false" VBox.vgrow="ALWAYS"
                maxWidth="1000" prefWidth="600" minWidth="300"
                fitToWidth="true"
                styleClass="chat-scroll-pane"
                hbarPolicy="NEVER"
    >
        <VBox fx:id="chatContainer" styleClass="chat-container"/>
    </ScrollPane>

    <VBox fx:id="sendBox"
          styleClass="home-page__send-box"
          alignment="TOP_CENTER"
          prefWidth="600" maxWidth="1000" minWidth="300"
    >
        <FlowPane fx:id="fileTagsPane" styleClass="home-page__file-tags"
                  prefWidth="600" maxWidth="1000" minWidth="300"
                  visible="false" managed="false"/>
        <TextArea fx:id="sendField" promptText="给呆芽发消息..." styleClass="home-page__send-field"
                  prefRowCount="1" maxWidth="1000" minWidth="300" prefWidth="600" wrapText="true"/>
        <HBox alignment="BOTTOM_RIGHT" spacing="8">
            <MenuButton fx:id="projectSelectButton" styleClass="home-page__project-menu-btn" prefHeight="37" visible="false" managed="false">
                <graphic>
                    <SvgImageView fitWidth="16" fitHeight="16" svgPath="/cn/bitloom/images/folder-black.svg"/>
                </graphic>
                <HBox.margin>
                    <Insets bottom="8"/>
                </HBox.margin>
            </MenuButton>
            <Button fx:id="branchDisplayButton" styleClass="home-page__branch-btn" prefHeight="37" visible="false" managed="false" disable="true">
                <graphic>
                    <SvgImageView fitWidth="16" fitHeight="16" svgPath="/cn/bitloom/images/git-branch.svg"/>
                </graphic>
                <HBox.margin>
                    <Insets bottom="8"/>
                </HBox.margin>
            </Button>
            <HBox fx:id="agentSelectorBox" alignment="CENTER_LEFT" spacing="4" styleClass="home-page__agent-selector-box">
                <SvgImageView fx:id="agentIcon" fitWidth="16" fitHeight="16" svgPath="/cn/bitloom/images/robot.svg"/>
                <ComboBox fx:id="agentSelector" styleClass="home-page__model-selector" prefHeight="37"/>
                <HBox.margin>
                    <Insets bottom="8"/>
                </HBox.margin>
            </HBox>
            <Button fx:id="canvasButton" styleClass="home-page__icon-btn" prefWidth="37" prefHeight="37">
                <graphic>
                    <SvgImageView fitWidth="20" fitHeight="20" svgPath="/cn/bitloom/images/canvas.svg"/>
                </graphic>
                <HBox.margin>
                    <Insets bottom="8"/>
                </HBox.margin>
            </Button>
            <Button fx:id="addFileButton" styleClass="home-page__icon-btn" prefWidth="37" prefHeight="37">
                <graphic>
                    <SvgImageView fitWidth="20" fitHeight="20" svgPath="/cn/bitloom/images/plus.svg"/>
                </graphic>
                <HBox.margin>
                    <Insets bottom="8"/>
                </HBox.margin>
            </Button>
            <Button fx:id="sendButton" styleClass="home-page__icon-btn" prefWidth="37" prefHeight="37">
                <graphic>
                    <SvgImageView fitWidth="20" fitHeight="20" svgPath="/cn/bitloom/images/arrow-up.svg"/>
                </graphic>
                <HBox.margin>
                    <Insets right="8" bottom="8"/>
                </HBox.margin>
            </Button>
            <Button fx:id="stopButton" visible="false" managed="false" styleClass="home-page__icon-btn,home-page__icon-btn--stop" prefWidth="37" prefHeight="37">
                <graphic>
                    <SvgImageView fitWidth="16" fitHeight="16" svgPath="/cn/bitloom/images/stop.svg"/>
                </graphic>
                <HBox.margin>
                    <Insets right="8" bottom="8"/>
                </HBox.margin>
            </Button>
        </HBox>
    </VBox>

</VBox>