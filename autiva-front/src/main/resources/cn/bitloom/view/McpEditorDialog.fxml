<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="520" prefWidth="560"
      stylesheets="@../style/scroll-bar.css,@../style/mcp-editor-dialog.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.bitloom.controller.McpEditorDialogController"
      styleClass="mcp-editor-dialog"
>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="mcp-editor-dialog__header">
        <TextField fx:id="nameField" promptText="输入服务器名称" styleClass="mcp-editor-dialog__name-field" HBox.hgrow="ALWAYS"/>
        <Button onAction="#cancel" styleClass="mcp-editor-dialog__btn" text="取消"/>
        <Button onAction="#saveMcp" styleClass="mcp-editor-dialog__btn" text="保存"/>
    </HBox>

    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER" styleClass="mcp-editor-dialog__scroll-pane">
        <VBox spacing="16" styleClass="mcp-editor-dialog__content">

            <VBox spacing="12" styleClass="mcp-editor-dialog__section">
                <Label styleClass="mcp-editor-dialog__section-label" text="连接类型"/>
                <ComboBox fx:id="connectionTypeCombo" styleClass="mcp-editor-dialog__combo" maxWidth="Infinity"/>
            </VBox>

            <VBox fx:id="stdioSection" spacing="12" styleClass="mcp-editor-dialog__section" visible="false" managed="false">
                <Label styleClass="mcp-editor-dialog__section-label" text="STDIO"/>
                <VBox styleClass="mcp-editor-dialog__card">
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="命令"/>
                        <TextField fx:id="stdioCommandField" promptText="如: npx, node, python" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="参数"/>
                        <TextField fx:id="stdioArgsField" promptText="空格分隔" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="环境变量"/>
                        <TextField fx:id="stdioEnvField" promptText="KEY=VALUE, 逗号分隔" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox fx:id="sseSection" spacing="12" styleClass="mcp-editor-dialog__section" visible="false" managed="false">
                <Label styleClass="mcp-editor-dialog__section-label" text="SSE"/>
                <VBox styleClass="mcp-editor-dialog__card">
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="URL"/>
                        <TextField fx:id="sseUrlField" promptText="服务器地址" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="端点"/>
                        <TextField fx:id="sseEndpointField" promptText="可选" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox fx:id="httpSection" spacing="12" styleClass="mcp-editor-dialog__section" visible="false" managed="false">
                <Label styleClass="mcp-editor-dialog__section-label" text="Streamable HTTP"/>
                <VBox styleClass="mcp-editor-dialog__card">
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="URL"/>
                        <TextField fx:id="httpUrlField" promptText="服务器地址" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                    <VBox spacing="10" styleClass="mcp-editor-dialog__field-group">
                        <Label styleClass="mcp-editor-dialog__field-label" text="端点"/>
                        <TextField fx:id="httpEndpointField" promptText="可选" styleClass="mcp-editor-dialog__field"/>
                    </VBox>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="mcp-editor-dialog__footer">
        <Label fx:id="statusLabel" styleClass="mcp-editor-dialog__status" text="就绪"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>
