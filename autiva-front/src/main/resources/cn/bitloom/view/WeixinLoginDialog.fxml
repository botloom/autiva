<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane styleClass="window-chrome"
      stylesheets="@../style/window-chrome.css,@../style/weixin-login.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cn.bitloom.controller.WeixinLoginController"
>

    <BorderPane fx:id="rootContainer" styleClass="window-chrome__content" prefWidth="320" prefHeight="400">

        <top>
            <HBox fx:id="toolbar" styleClass="window-chrome__toolbar">
                <HBox styleClass="window-chrome__icon-area">
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                        <Image url="/cn/bitloom/images/icon.png" requestedWidth="18" requestedHeight="18"/>
                    </ImageView>
                </HBox>
                <HBox styleClass="window-chrome__toolbar-buttons">
                    <Label text="微信扫码登录" styleClass="weixin-login__toolbar-title"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS" styleClass="window-chrome__spacer"/>
                <HBox styleClass="window-chrome__controls">
                    <Button fx:id="closeBtn" styleClass="window-chrome__btn,window-chrome__btn--close" contentDisplay="GRAPHIC_ONLY"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox styleClass="weixin-login__body" alignment="CENTER" spacing="16">
                <Label text="请使用微信扫描下方二维码" styleClass="weixin-login__subtitle"/>

                <StackPane styleClass="weixin-login__qr-container">
                    <ImageView fx:id="qrCodeImageView" styleClass="weixin-login__qr-image"/>
                    <VBox fx:id="loadingPane" styleClass="weixin-login__overlay" alignment="CENTER" spacing="8">
                        <Label text="⏳" styleClass="weixin-login__overlay-icon"/>
                        <Label text="生成二维码中..." styleClass="weixin-login__overlay-text"/>
                    </VBox>
                    <VBox fx:id="successPane" styleClass="weixin-login__overlay" alignment="CENTER" spacing="8" visible="false">
                        <Label text="✅" styleClass="weixin-login__overlay-icon"/>
                        <Label text="登录成功" styleClass="weixin-login__overlay-text--success"/>
                    </VBox>
                    <VBox fx:id="errorPane" styleClass="weixin-login__overlay" alignment="CENTER" spacing="8" visible="false">
                        <Label text="❌" styleClass="weixin-login__overlay-icon"/>
                        <Label fx:id="errorText" text="登录失败" styleClass="weixin-login__overlay-text--error"/>
                    </VBox>
                </StackPane>

                <Label fx:id="statusLabel" text="等待扫码..." styleClass="weixin-login__status"/>
            </VBox>
        </center>

    </BorderPane>

</StackPane>
