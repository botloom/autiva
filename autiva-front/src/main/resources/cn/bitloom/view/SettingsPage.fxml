<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="settingsPage" styleClass="settings-page" visible="false" managed="false" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="cn.bitloom.controller.SettingsPageController"
      alignment="TOP_CENTER"
      stylesheets="@../style/settings-page.css"
>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="settings-page__scroll-pane" prefWidth="600" maxWidth="700">
        <VBox styleClass="settings-page__content">
            <VBox>
                <Label text="浏览器" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="浏览器路径" styleClass="settings-page__row-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="settings-page__path-row">
                            <TextField fx:id="browserPathTextField" styleClass="settings-page__path-field" HBox.hgrow="ALWAYS"
                                       promptText="选择浏览器可执行文件"/>
                            <Button fx:id="browseBrowserButton" text="更改" styleClass="settings-page__secondary-btn"/>
                        </HBox>
                        <Label text="用于抓取的浏览器路径" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="钉钉配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="Client ID" styleClass="settings-page__row-title"/>
                        <TextField fx:id="dingTalkClientIdField" styleClass="settings-page__path-field"
                                   promptText="钉钉应用 Client ID"/>
                        <Label text="钉钉应用的 Client ID" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="settings-page__row">
                        <Label text="Client Secret" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="dingTalkClientSecretField" styleClass="settings-page__path-field"
                                       promptText="钉钉应用 Client Secret"/>
                        <Label text="钉钉应用的 Client Secret" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="微信配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="iLink 接入" styleClass="settings-page__row-title"/>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="settings-page__path-row">
                            <CheckBox fx:id="weixinEnabledCheckBox" text="启用" styleClass="settings-page__tool-checkbox"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="weixinStatusLabel" text="未连接" styleClass="settings-page__row-subtitle"/>
                            <Button fx:id="weixinLoginButton" text="扫码登录" styleClass="settings-page__secondary-btn"/>
                        </HBox>
                        <Label text="启用后通过微信 iLink 协议接入，扫码登录即可对话" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="AI 配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="DeepSeek API Key" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="deepseekApiKeyField" styleClass="settings-page__path-field"
                                       promptText="DeepSeek API Key"/>
                        <Label text="DeepSeek 平台的 API Key" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="settings-page__row">
                        <Label text="智谱 AI API Key" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="zApiKeyField" styleClass="settings-page__path-field"
                                       promptText="智谱 AI API Key"/>
                        <Label text="智谱 AI 平台的 API Key" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="关于" styleClass="settings-page__section-label"/>
                <VBox>
                    <VBox styleClass="settings-page__about-content" spacing="4">
                        <Label text="IdeaForge" styleClass="settings-page__app-name"/>
                        <Label text="版本 1.0.0" styleClass="settings-page__app-version"/>
                        <Label text="© 2026 bitloom" styleClass="settings-page__app-copyright"/>
                    </VBox>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" styleClass="settings-page__spacer"/>

        </VBox>
    </ScrollPane>
</VBox>