<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox fx:id="settingsPage" styleClass="settings-page" visible="false" managed="false" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="cn.bitloom.controller.SettingsPageController"
      alignment="TOP_CENTER"
      stylesheets="@../style/settings-page.css"
>
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="settings-page__scroll-pane" prefWidth="600" maxWidth="700">
        <VBox styleClass="settings-page__content">
            <!-- 用户登录卡片 -->
            <VBox>
                <Label text="用户" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card" fx:id="userCard">
                    <HBox styleClass="settings-page__user-row" alignment="CENTER_LEFT">
                        <StackPane styleClass="settings-page__avatar-stack">
                            <ImageView fx:id="userAvatar" styleClass="settings-page__avatar" fitWidth="48" fitHeight="48">
                                <Image url="@../images/icon.png"/>
                            </ImageView>
                        </StackPane>
                        <VBox styleClass="settings-page__user-info" HBox.hgrow="ALWAYS">
                            <Label fx:id="userNameLabel" text="点击登录" styleClass="settings-page__user-name"/>
                            <Label fx:id="userIdLabel" text="未登录" styleClass="settings-page__user-id"/>
                        </VBox>
                        <Button fx:id="loginButton" text="登录" styleClass="settings-page__login-btn"
                                onAction="#handleLogin"/>
                        <Button fx:id="logoutButton" text="退出" styleClass="settings-page__logout-btn"
                                visible="false" managed="false"
                                onAction="#handleLogout"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="钉钉配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="Client ID" styleClass="settings-page__row-title"/>
                        <TextField fx:id="dingTalkClientIdField" styleClass="settings-page__path-field"
                                   promptText="钉钉应用 Client ID"/>
                        <Label text="钉钉应用的 Client ID" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="settings-page__row">
                        <Label text="Client Secret" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="dingTalkClientSecretField" styleClass="settings-page__path-field"
                                       promptText="钉钉应用 Client Secret"/>
                        <Label text="钉钉应用的 Client Secret" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="微信配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox fx:id="weixinQrRow" styleClass="settings-page__row" alignment="CENTER">
                        <StackPane styleClass="settings-page__qr-stack">
                            <ImageView fx:id="weixinQrImageView" styleClass="settings-page__qr-image"/>
                            <VBox fx:id="weixinConnectedOverlay" styleClass="settings-page__qr-overlay" alignment="CENTER" visible="false">
                                <Button fx:id="weixinRebindButton" text="重新加载" styleClass="settings-page__rebind-btn"/>
                            </VBox>
                            <VBox fx:id="weixinExpiredOverlay" styleClass="settings-page__qr-overlay" alignment="CENTER" visible="false">
                                <Button fx:id="weixinRefreshButton" text="重新加载" styleClass="settings-page__rebind-btn"/>
                            </VBox>
                        </StackPane>
                        <Label fx:id="weixinQrHintLabel" text="扫码即可绑定微信" styleClass="settings-page__qr-hint" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="搜索配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="博查 API Key" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="bochaApiKeyField" styleClass="settings-page__path-field"
                                       promptText="博查搜索 API Key"/>
                        <Label text="博查搜索平台的 API Key，用于 WebSearch 工具" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox>
                <Label text="DeepSeek 配置" styleClass="settings-page__section-label"/>
                <VBox styleClass="settings-page__card">
                    <VBox styleClass="settings-page__row">
                        <Label text="API Key" styleClass="settings-page__row-title"/>
                        <PasswordField fx:id="deepseekApiKeyField" styleClass="settings-page__path-field"
                                       promptText="DeepSeek API Key"/>
                        <Label text="DeepSeek 平台的 API Key" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="settings-page__row">
                        <Label text="Base URL" styleClass="settings-page__row-title"/>
                        <TextField fx:id="deepseekBaseUrlField" styleClass="settings-page__path-field"
                                   promptText="https://api.deepseek.com"/>
                        <Label text="DeepSeek API 基础地址" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="settings-page__row">
                        <Label text="Completions Path" styleClass="settings-page__row-title"/>
                        <TextField fx:id="deepseekCompletionsPathField" styleClass="settings-page__path-field"
                                   promptText="/v1/chat/completions"/>
                        <Label text="API 补全路径" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="settings-page__row">
                        <Label text="模型" styleClass="settings-page__row-title"/>
                        <TextField fx:id="deepseekChatModelField" styleClass="settings-page__path-field"
                                   promptText="deepseek-chat"/>
                        <Label text="聊天模型名称" styleClass="settings-page__row-subtitle" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" styleClass="settings-page__spacer"/>

        </VBox>
    </ScrollPane>
</VBox>